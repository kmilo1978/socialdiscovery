# ==============================================================
# Social Discovery Engine - Environment Variables
# Copy this file to `.env.local` and fill in your key.
# ==============================================================

# --- SerpAPI (required for API mode; Basic mode and email validation need no key) ---
# Free tier: 100 searches/month, no credit card required.
# 1. Sign up: https://serpapi.com/users/sign_up
# 2. Copy your API key from the dashboard: https://serpapi.com/manage-api-key
# 3. Paste it below.
#
# To upgrade later (more searches/month), just change your plan on SerpAPI's
# pricing page (https://serpapi.com/pricing) — this same key keeps working,
# no code or env changes needed here.
SERPAPI_KEY=
